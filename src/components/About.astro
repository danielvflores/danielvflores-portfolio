---
import Social from "./Social.astro";
import CVButton from "./CVButton.astro";
import LenguageCard from "./LenguageCard.astro";
import "../styles/cursorAnimation.css";

import { PERSONAL_INFO } from "../const/config";
import { technologies } from "../const/worksInformation.js";
---

<section
  id="about"
  class="flex flex-col lg:flex-row items-center lg:gap-16 gap-8 py-8 lg:py-16 px-4 sm:px-6 lg:px-24"
>
  <!-- IMG TOP/RIGHT -->
  <div
    class="w-32 h-32 sm:w-40 sm:h-40 lg:w-64 lg:h-64 rounded-full overflow-hidden relative shadow-lg order-1 lg:order-2 flex-shrink-0"
  >
    <img
      src={PERSONAL_INFO.profileImage}
      alt={`Foto de perfil de ${PERSONAL_INFO.name}`}
      class="w-full h-full object-cover object-center no-select"
      width="256"
      height="256"
      loading="eager"
    />
    <div class="absolute inset-0 z-10 select-none pointer-events-auto" style="background: transparent;"></div>
  </div>

  <!-- Text BOTTOM/LEFT -->
  <div class="flex-1 max-w-2xl text-center lg:text-left order-2 lg:order-1">
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4 leading-tight">
      ¡Hola, soy Daniel! Soy un
      <span id="dynamic-word" class="text-blue-600"></span><span
        id="cursor"
        class="animate-blink">|</span
      >
    </h1>
    <p class="text-gray-600 mb-6 text-sm sm:text-base leading-relaxed">
      Hola, soy estudiante de Ingeniería Civil Informática y me apasiona el mundo de la tecnología, la infraestructura y los servidores.
      Me interesa especialmente el área de cloud, la administración de servidores VPS y entornos Linux, junto con la seguridad informática y el aprendizaje constante.
      Disfruto crear, configurar y optimizar sistemas, buscando siempre mejorar mis habilidades y adquirir nuevos conocimientos dentro del mundo IT.
    </p>
    <!-- Social Media Component + CV Button -->
    <div class="flex flex-wrap gap-4 justify-center lg:justify-start items-center">
      <Social />
      <CVButton />
    </div>
  </div>
</section>

<section id="lenguages" class="px-4 sm:px-6 lg:px-24 py-8">
  <h3 class="text-2xl font-bold text-center mb-8">
    Tecnologías y Herramientas
  </h3>

  <div
    class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 max-w-7xl mx-auto"
  >
    {technologies.map(tech => (
      <LenguageCard
        title={tech.title}
        description={tech.description}
        imageUrl={tech.imageUrl}
        imageAlt={tech.imageAlt}
      />
    ))}
  </div>
</section>

<script>
  import { startTypingEffect } from "../scripts/typingEffect";
  const aboutTitleWords = ["Developer 💻", "Cloud Manager ☁️"];
  startTypingEffect(aboutTitleWords);
</script>


