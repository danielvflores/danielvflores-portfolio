---
const {
  title,
  description,
  techs = [],
  repoUrl,
  demoUrl = null,
  featured = false,
  status = "Completado",
  type = "general",
  icon = "🚀",
  gradient = "",
  year = ""
} = Astro.props;

const getTypeColor = (type: string) => {
  const colors: Record<string, string> = {
    fullstack: "bg-ubuntu-purple/20 text-ubuntu-purple border border-ubuntu-purple/50",
    backend: "bg-ubuntu-blue/20 text-ubuntu-blue border border-ubuntu-blue/50",
    security: "bg-ubuntu-red/20 text-ubuntu-red border border-ubuntu-red/50",
    plugin: "bg-ubuntu-green/20 text-ubuntu-green border border-ubuntu-green/50",
    general: "bg-ubuntu-text-tertiary/20 text-ubuntu-text border border-ubuntu-border"
  };
  return colors[type] || colors.general;
};

const getStatusColor = (status: string) => {
  const colors: Record<string, string> = {
    "En desarrollo": "bg-ubuntu-yellow/20 text-ubuntu-yellow border border-ubuntu-yellow/50",
    "Completado": "bg-ubuntu-green/20 text-ubuntu-green border border-ubuntu-green/50",
    "Pausado": "bg-ubuntu-text-tertiary/20 text-ubuntu-text border border-ubuntu-border"
  };
  return colors[status] || colors["Completado"];
};
---

<div class={`group relative bg-ubuntu-bg-secondary rounded-lg border border-ubuntu-border shadow-md hover:shadow-2xl hover:border-ubuntu-green transition-all duration-500 transform hover:scale-105 overflow-hidden w-full card-ubuntu float-hover`}>
  <!-- Gradient header for featured projects -->
  {featured && (
    <div class={`h-2 bg-gradient-to-r from-ubuntu-green to-ubuntu-blue`}></div>
  )}

  <!-- Content container -->
  <div class="p-6 relative">
    <!-- Featured badge - movido arriba del header -->
    {featured && (
      <div class="mb-3">
        <span class="bg-gradient-to-r from-ubuntu-yellow to-ubuntu-orange text-ubuntu-dark-bg text-xs font-bold px-3 py-1 rounded-full shadow-lg inline-block font-ubuntu">
          ⭐ DESTACADO
        </span>
      </div>
    )}

    <!-- Header with icon and meta info -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center space-x-3">
        <div class={`w-12 h-12 rounded-lg bg-gradient-to-r from-ubuntu-green to-ubuntu-blue flex items-center justify-center text-white text-xl shadow-lg group-hover:scale-110 transition-transform`}>
          {icon}
        </div>
        <div>
          <h3 class="text-xl font-bold text-ubuntu-text group-hover:text-ubuntu-green transition-colors font-ubuntu">
            {title}
          </h3>
          <div class="flex items-center space-x-2 mt-1">
            <span class={`text-xs font-medium px-2 py-1 rounded-full ${getTypeColor(type)}`}>
              {type.charAt(0).toUpperCase() + type.slice(1)}
            </span>
            <span class="text-ubuntu-text-tertiary text-xs">•</span>
            <span class="text-ubuntu-text-secondary text-xs font-ubuntu">{year}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Description -->
    <p class="text-ubuntu-text-secondary mb-4 leading-relaxed text-sm">
      {description}
    </p>

    <!-- Status indicator -->
    <div class="flex items-center mb-4">
      <div class="flex items-center space-x-2">
        <div class={`w-2.5 h-2.5 rounded-full glow-pulse ${status === 'En desarrollo' ? 'bg-ubuntu-yellow' : 'bg-ubuntu-green'}`}></div>
        <span class={`text-xs font-medium px-2 py-1 rounded-full ${getStatusColor(status)}`}>
          {status}
        </span>
      </div>
    </div>

    <!-- Technologies -->
    <div class="mb-6">
      <div class="flex flex-wrap gap-2">
        {techs.slice(0, 4).map((tech: string) => (
          <span class="bg-ubuntu-bg-tertiary hover:bg-ubuntu-bg-tertiary/80 text-ubuntu-green px-3 py-1 rounded-lg text-xs font-medium border border-ubuntu-green/30 transition-all duration-300 hover:border-ubuntu-green hover:shadow-sm hover:shadow-ubuntu-glow-green">
            {tech}
          </span>
        ))}
        {techs.length > 4 && (
          <span class="bg-ubuntu-blue/20 text-ubuntu-blue px-3 py-1 rounded-lg text-xs font-medium border border-ubuntu-blue/50">
            +{techs.length - 4} más
          </span>
        )}
      </div>
    </div>

    <!-- Footer with actions -->
    <div class="flex items-center justify-between pt-4 border-t border-ubuntu-border">
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center space-x-2 text-ubuntu-green hover:text-ubuntu-blue font-medium text-sm transition-all duration-300 group/link hover:drop-shadow-lg"
      >
        <svg class="w-4 h-4 transition-transform group-hover/link:scale-110" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
          <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
        </svg>
        <span>GitHub</span>
        <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>

      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-1.5 text-ubuntu-orange hover:text-ubuntu-yellow font-medium text-sm transition-all duration-300 group/demo hover:bg-ubuntu-orange/10 px-2 py-1 rounded-lg hover:drop-shadow-lg"
        >
          <svg class="w-3.5 h-3.5 transition-transform group-hover/demo:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          <span>Demo</span>
        </a>
      )}

      <!-- GitHub stars placeholder // FOR LATER USE -->
      <div class="flex items-center space-x-1 text-ubuntu-text-tertiary text-xs">
      </div>
    </div>

  </div>

  <!-- Hover effect overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-ubuntu-green/5 to-ubuntu-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-lg"></div>
</div>

<style>
  /* Removed line-clamp styles since we want full description */
</style>
