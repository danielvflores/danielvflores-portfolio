---
export interface Props {
  title: string;
  description: string;
  imageUrl: string;
  imageAlt: string;
}

const { title, description, imageUrl, imageAlt } = Astro.props;
---

<div class="
    group relative border border-ubuntu-border bg-ubuntu-bg-secondary p-6 rounded-lg shadow-md
    hover:shadow-2xl hover:border-ubuntu-green hover:scale-105 transition-all duration-500 transform
    flex flex-col text-center
    w-full max-w-sm mx-auto
    min-h-fit overflow-hidden
    card-ubuntu float-hover
  ">
  <!-- Icon -->
  <div class="flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
    <div class="w-16 h-16 overflow-hidden rounded-md flex items-center justify-center bg-ubuntu-bg-tertiary/50 group-hover:bg-ubuntu-bg-tertiary transition-colors duration-300">
      <img src={imageUrl} alt={imageAlt} class="max-w-full max-h-full object-contain" />
    </div>
  </div>

  <!-- Title -->
  <h4 class="text-lg font-semibold mb-3 text-ubuntu-text font-ubuntu group-hover:text-ubuntu-green transition-colors duration-300">{title}</h4>

  <!-- Description -->
  <p class="text-ubuntu-text-secondary text-sm leading-relaxed group-hover:text-ubuntu-text transition-colors duration-300">
    {description}
  </p>

  <!-- Hover effect overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-ubuntu-green/10 to-ubuntu-blue/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-lg"></div>
</div>
