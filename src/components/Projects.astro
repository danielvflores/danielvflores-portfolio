---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../const/worksInformation.js";
import { SOCIAL_LINKS } from "../const/config";
---

<section class="content-section projects-section">
  <div class="section-heading fade-in-up">
    <span class="section-kicker">Proyectos</span>
    <h2>Proyectos en los que he trabajado.</h2>
    <p>
      Estos proyectos son los principales en los que he trabajado siendo proyectos personales o colaborativos.
      Estos proyectos reflejan parte de mi perfil técnico y de mi forma de trabajar, enfocada en backend, infraestructura y despliegues.
    </p>
    <a
      href={SOCIAL_LINKS.github}
      class="section-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      Ver perfil completo en GitHub →
    </a>
  </div>

  <div class="project-summary fade-in-up" style="animation-delay: 100ms">
    <div>
      <strong>{projects.length}</strong>
      <span>Proyectos destacados</span>
    </div>
    <div>
      <strong>Backend</strong>
      <span>APIs, plugins y lógica</span>
    </div>
    <div>
      <strong>Cloud</strong>
      <span>Deploy, VPS y servicios</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 2xl:grid-cols-3 max-w-6xl mx-auto items-stretch">
    {projects.map((project, idx) => (
      <div class="fade-in-up" style={`animation-delay: ${idx * 80}ms`}>
        <ProjectCard
          title={project.title}
          description={project.description}
          techs={project.techs}
          repoUrl={project.repoUrl}
          demoUrl={project.demoUrl}
          status={project.status}
          type={project.type}
          icon={project.icon}
          gradient={"gradient" in project ? project.gradient : ""}
          year={project.year}
        />
      </div>
    ))}
  </div>
</section>
